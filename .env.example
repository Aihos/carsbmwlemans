# Copie ce fichier en `.env` puis remplis les valeurs.
# Cle API Resend -> https://resend.com/api-keys
RESEND_API_KEY=
# Adresse qui recoit les demandes de rendez-vous (virgules si plusieurs).
# Facultatif : sans MAIL_TO, les demandes partent vers l'adresse de MAIL_FROM.
MAIL_TO=
# Expediteur, sur le domaine verifie sur Resend.
# Laisser onboarding@resend.dev tant que le domaine n'est pas verifie.
MAIL_FROM="Ventes privées BMW Le Mans <onboarding@resend.dev>"
